{
  "name": "easy2-deploy",
  "version": "0.2.0",
  "description": "命令行交互式的文件发布工具：通过 SSH(SFTP) 或 FTP 把本地文件上传到服务器",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemonppai/easy-deploy.git"
  },
  "main": "index.js",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.js"
    }
  },
  "bin": {
    "easy2-deploy": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "index.js",
    "README.md"
  ],
  "engines": {
    "node": ">=16.14"
  },
  "keywords": [
    "deploy",
    "sftp",
    "ssh",
    "ftp",
    "cli",
    "interactive",
    "发布",
    "部署"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "deploy": "node bin/cli.js",
    "test": "node test/run.js"
  },
  "dependencies": {
    "basic-ftp": "^5.3.1",
    "cfonts": "^2.9.3",
    "chalk": "^4.1.2",
    "fast-glob": "^3.3.3",
    "inquirer": "^8.2.7",
    "node-ssh": "^13.2.1"
  }
}
